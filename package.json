{
  "name": "wedding-picture-uploader",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "bun --bun vite --host 0.0.0.0",
    "build": "bun --bun vite build",
    "start": "NODE_ENV=production bun scripts/serve.ts",
    "check": "bun run typecheck && bun run format:check",
    "lint": "bun run check",
    "typecheck": "tsc --noEmit",
    "db:generate": "bun --bun drizzle-kit generate",
    "db:migrate": "bun --bun drizzle-kit migrate",
    "db:studio": "bun --bun drizzle-kit studio",
    "db:baseline": "bun scripts/baseline.ts",
    "test:e2e": "bun --bun playwright test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky",
    "test:db": "bun test tests/database-migration.test.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.5",
    "@tanstack/react-router": "^1.170.46",
    "@tanstack/react-start": "^1.169.4",
    "@uploadthing/react": "^7.3.3",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "lucide-react": "^0.561.0",
    "postgres": "^3.4.7",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "uploadthing": "^7.7.4",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.11",
    "@types/bun": "^1.4.4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "drizzle-kit": "^0.31.8",
    "husky": "^9.1.7",
    "prettier": "^3.7.4",
    "tailwindcss": "^4.1.11",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "vite": "^8.3.5"
  },
  "type": "module",
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  }
}
